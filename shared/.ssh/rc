#!/bin/sh
# Set random terminal background color on SSH login

# Keep one stable path for agents forwarded through short-lived SSH
# connections. Long-lived processes, such as the Codex remote app server, keep
# this path while later SSH connections update its target.
if [ -n "${SSH_AUTH_SOCK:-}" ] && [ -S "$SSH_AUTH_SOCK" ]; then
    stable_agent="$HOME/.ssh/forwarded-agent.sock"
    temporary_agent="${stable_agent}.$$"

    if [ ! -e "$stable_agent" ] || [ -L "$stable_agent" ]; then
        rm -f "$temporary_agent"
        if ln -s "$SSH_AUTH_SOCK" "$temporary_agent"; then
            mv -f "$temporary_agent" "$stable_agent"
        fi
    fi
fi

